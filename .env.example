# Reference only. Set secrets in Vercel Project Settings > Environment Variables.
# Never commit credentials or use NEXT_PUBLIC_ for them.
OPENROUTER_API_KEY=

# Explicitly allow the public production submission. Both flags default to false.
NUMBASE_PUBLIC_ACCESS_ENABLED=false
# For separately authenticated deployments only; this flag does not implement auth.
NUMBASE_DEPLOYMENT_PROTECTED=false

# Reuse the existing private Supabase project and bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NUMBASE_SESSION_SECRET=
# Enable when paid image generation is intended.
NUMBASE_IMAGE_GENERATION_ENABLED=false

# Enable only after reviewing/applying 002_private_documents.sql in the existing project.
# OpenRouter embeddings use the same server-only API key.
NUMBASE_DOCUMENTS_ENABLED=false
# Enable only after reviewing/applying 003_extraction_allowance.sql.
NUMBASE_EXTRACTION_ENABLED=false
NUMBASE_FILE_GENERATION_ENABLED=false
